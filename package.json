{
  "name": "cs2-c4-damage",
  "version": "0.0.0",
  "private": true,
  "description": "Uncertainty-aware CS2 C4 damage library foundation",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gsi": {
      "import": {
        "types": "./dist/gsi.d.ts",
        "default": "./dist/gsi.js"
      },
      "require": {
        "types": "./dist/gsi.d.cts",
        "default": "./dist/gsi.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CREDITS.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starfie1d1272/cs2-c4-damage.git"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
