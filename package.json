{
  "name": "cs2-c4-damage",
  "version": "0.1.0-beta.1",
  "description": "CS2 C4 damage prediction from baked map fields and Game State Integration snapshots",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cs2-c4-damage": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gsi": {
      "import": {
        "types": "./dist/gsi.d.ts",
        "default": "./dist/gsi.js"
      },
      "require": {
        "types": "./dist/gsi.d.cts",
        "default": "./dist/gsi.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CREDITS.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starfie1d1272/cs2-c4-damage.git"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://github.com/Starfie1d1272/cs2-c4-damage#readme",
  "bugs": {
    "url": "https://github.com/Starfie1d1272/cs2-c4-damage/issues"
  },
  "keywords": [
    "cs2",
    "counter-strike",
    "c4",
    "damage",
    "gsi",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
